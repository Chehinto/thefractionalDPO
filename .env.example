# Local Supabase (supabase start prints these).
# Production uses a project in an EU region — the register holds EU personal
# data and Art. 44 transfer rules make region a design constraint, not a setting.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never referenced from a client component; used by tests to
# provision users and by future admin paths that must not depend on RLS.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (pay-as-you-go: the platform's own key, used server-side).
# There is no plan where a customer brings their own provider, so this is the
# only key the runtime looks for. ANTHROPIC_API_KEY is accepted as a fallback so
# a machine already set up for another project works without a second variable.
# Unset outside production, the runtime returns a clearly-labelled local draft
# instead of calling out; in production it refuses rather than filling a review
# queue with placeholders.
DPO_AI_KEY=
# Optional. Only "anthropic" is implemented — AxioVendo's other adapters exist
# for its bring-your-own-key plan, which this product does not have.
DPO_AI_PROVIDER=anthropic
