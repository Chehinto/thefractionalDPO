# Local Supabase (supabase start prints these).
# Production uses a project in an EU region — the register holds EU personal
# data and Art. 44 transfer rules make region a design constraint, not a setting.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never referenced from a client component; used by tests to
# provision users and by future admin paths that must not depend on RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of OAuth providers to show as sign-in buttons, e.g.
# "google,azure". Empty or unset shows none. This is a plain Vercel variable,
# never Sensitive: a Sensitive NEXT_PUBLIC_* is withheld from the build, so
# Next inlines nothing into the client bundle and the server throws
# "NEXT_PUBLIC_SUPABASE_URL is not set" on any page that resolves a session —
# the 17 Sep 2026 outage CLAUDE.md records. Marking it Sensitive protects
# nothing anyway; it ships to every visitor inside the JavaScript regardless.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# Read by `supabase start` when it renders supabase/config.toml, NOT by Vercel:
# a hosted project's providers are configured in its own auth settings. Leave
# both blank unless you have registered an OAuth client and flipped that
# provider's `enabled` in config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=

# AI provider (pay-as-you-go: the platform's own key, used server-side).
# There is no plan where a customer brings their own provider, so this is the
# only key the runtime looks for. ANTHROPIC_API_KEY is accepted as a fallback so
# a machine already set up for another project works without a second variable.
# Unset outside production, the runtime returns a clearly-labelled local draft
# instead of calling out; in production it refuses rather than filling a review
# queue with placeholders.
DPO_AI_KEY=
# Optional. Only "anthropic" is implemented — AxioVendo's other adapters exist
# for its bring-your-own-key plan, which this product does not have.
DPO_AI_PROVIDER=anthropic

# Outbound email (Resend). Unset, nothing is sent and every attempt is recorded
# as skipped_unconfigured — the product still works, a DPO just copies links.
RESEND_API_KEY=
EMAIL_FROM="Fractional DPO <notifications@example.invalid>"
# Comma-separated addresses or @domains. When set, only these are mailed and
# everything else is recorded as skipped. Keep it set outside production: the
# fixtures are full of plausible company addresses.
EMAIL_ALLOWLIST=
